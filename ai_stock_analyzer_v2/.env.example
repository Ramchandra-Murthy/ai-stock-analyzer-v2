# Copy this file to ".env" (which is git-ignored) and fill in your own values.
# Real environment variables take precedence over values in .env.

# --- Dhan: live NIFTY/BANKNIFTY/FINNIFTY option chains and live equity candles ---
# Create an access token in the Dhan web console. Tokens expire, so refresh when you
# see "HTTP 401 Unauthorized" in the options pages.
DHAN_CLIENT_ID=
DHAN_ACCESS_TOKEN=

# Live equity candles need an instrument map from symbol to Dhan security ID. Look the
# IDs up in Dhan's instrument master (scrip master) file. Key by "EXCHANGE:SYMBOL" so
# NSE and BSE never get mixed up. For BSE the symbol is the numeric scrip code used by
# this app (e.g. "BSE:500325"). A bare "SYMBOL" key is treated as NSE only.
# Example: {"NSE:RELIANCE": 2885, "BSE:<scrip code>": <Dhan security id>}
DHAN_SECURITY_MAP_JSON=

# --- Optional ---
# SUPABASE_URL=
# SUPABASE_SECRET_KEY=
# WATCHLIST_DATABASE_PATH=data/watchlist.sqlite3
# EROS_SCAN_DB=data/eros_scans.sqlite3

# Optional alerts (see scripts/run_alerts.py). Keep real values out of git.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_TO=
ALERT_SYMBOLS=RELIANCE,TCS
ALERT_STRATEGY=Supertrend
ALERT_DRAWDOWN=0.10
