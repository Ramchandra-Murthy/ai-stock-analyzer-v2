{
  "name": "AI Stock Analyzer (Streamlit)",
  // Python 3.13 matches .python-version, pyproject.toml and the Dockerfile.
  "image": "mcr.microsoft.com/devcontainers/python:1-3.13-bookworm",
  "customizations": {
    "codespaces": {
      "openFiles": [
        "README.md",
        "app.py"
      ]
    },
    "vscode": {
      "settings": {
        "python.defaultInterpreterPath": "${containerWorkspaceFolder}/.venv/bin/python"
      },
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "charliermarsh.ruff"
      ]
    }
  },
  // Install the locked dependencies (pyproject.toml + uv.lock), the same ones CI and Docker use.
  "updateContentCommand": "python -m pip install --user uv && uv sync --locked && echo 'Dependencies installed from uv.lock'",
  // Start the Streamlit app every time the repository is opened.
  "postAttachCommand": {
    "server": "uv run streamlit run app.py --server.headless true --server.enableCORS false --server.enableXsrfProtection false"
  },
  "portsAttributes": {
    "8501": {
      "label": "AI Stock Analyzer",
      "onAutoForward": "openPreview"
    }
  },
  "forwardPorts": [
    8501
  ]
}
